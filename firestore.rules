rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'saraissa265@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // Catalog Products
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Dress Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Designers
    match /designers/{designerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Store Settings
    match /storeSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Customer Orders
    match /orders/{orderId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isValidId(orderId) && resource != null);
      
      allow create: if request.resource.data.keys().hasAll(['id', 'orderNumber', 'customerName', 'customerPhone', 'city', 'items', 'total', 'status'])
        && request.resource.data.customerName is string && request.resource.data.customerName.size() >= 2 && request.resource.data.customerName.size() <= 100
        && request.resource.data.customerPhone is string && request.resource.data.customerPhone.size() >= 7 && request.resource.data.customerPhone.size() <= 30
        && request.resource.data.city is string && request.resource.data.city.size() <= 100
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.total is number && request.resource.data.total >= 0
        && (request.resource.data.status == 'new' || request.resource.data.status == 'pending_payment_verification');

      allow update, delete: if isAdmin();
    }

    // Custom Tailoring Requests
    match /customRequests/{requestId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isValidId(requestId) && resource != null);

      allow create: if request.resource.data.keys().hasAll(['id', 'requestNumber', 'customerName', 'customerPhone', 'city', 'dressType', 'designDescription', 'status'])
        && request.resource.data.customerName is string && request.resource.data.customerName.size() >= 2 && request.resource.data.customerName.size() <= 100
        && request.resource.data.customerPhone is string && request.resource.data.customerPhone.size() >= 7 && request.resource.data.customerPhone.size() <= 30
        && request.resource.data.city is string && request.resource.data.city.size() <= 100
        && request.resource.data.designDescription is string && request.resource.data.designDescription.size() >= 5 && request.resource.data.designDescription.size() <= 2000
        && request.resource.data.status == 'new';

      allow update, delete: if isAdmin();
    }
  }
}
